# ============================================================================
# AX AgriEdu Backend - Environment Variables Template
# ============================================================================
# Copy this file to .env for local development
# For production, use Cloud Run environment variables
# ============================================================================

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
# Local Development
DATABASE_URL=postgresql+asyncpg://genova_user:genova_password@localhost:5432/genova_ai

# Cloud SQL (Production) - auto-constructed by deployment script
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# Redis Configuration
# ============================================================================
# Local Development (Docker)
REDIS_URL=redis://localhost:6379/0

# Production (Upstash)
# REDIS_URL=rediss://default:password@host:port

# ============================================================================
# Application Configuration
# ============================================================================
DEBUG=true
LOG_LEVEL=INFO

# ============================================================================
# Google Cloud Configuration
# ============================================================================
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-northeast3
GOOGLE_CLOUD_LOCATION_VERTEX_AI=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ============================================================================
# Google Cloud Storage
# ============================================================================
GCS_BUCKET_NAME=your-bucket-name
GCS_SIGNED_URL_EXPIRY=3600
GCP_BASE_OUTPUT_DIR=uploaded_tmp
GCS_UPLOAD_TIMEOUT_SEC=900
GCS_UPLOAD_CHUNK_MB=8

# ============================================================================
# AI Services Configuration
# ============================================================================
# Google GenAI API Key (for Gemini models via API key auth)
GENAI_API_KEY=your-genai-api-key

# Vertex AI Model Configuration
VERTEX_AI_MODEL=gemini-3-flash-preview
SUMMARIZATION_MODEL=gemini-3-flash-preview

# AI Generation Configuration
SUMMARIZATION_TEMPERATURE=0.4
SUMMARIZATION_MAX_OUTPUT_TOKENS=20000

# ============================================================================
# File Upload Configuration
# ============================================================================
MAX_FILE_SIZE=2147483648  # 2GB in bytes
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv,webm

# ============================================================================
# Processing Configuration
# ============================================================================
MAX_CONCURRENT_JOBS=3
PROCESSING_TIMEOUT=3600

# ============================================================================
# Video Processing Configuration
# ============================================================================
SPLIT_DIR=split_videos
SUBTITLE_DIR=subtitles
MINIMUM_VIDEO_DURATION_SEC=60
FILE_SAVE_DIR=/path/to/data  # For local development

# ============================================================================
# API Security
# ============================================================================
API_KEYS=your-api-key-here

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
